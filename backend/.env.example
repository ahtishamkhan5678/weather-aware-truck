# Copy to .env (or set in your host) — every value is optional for local dev.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Allow Vercel preview deployments of the frontend too (optional):
# CORS_ALLOWED_ORIGIN_REGEXES=^https://weather-aware-web(-[a-z0-9-]+)?\.vercel\.app$

# Routing: "valhalla" (truck profile, primary) with automatic OSRM fallback.
VALHALLA_BASE_URL=https://valhalla1.openstreetmap.de
OSRM_BASE_URL=https://router.project-osrm.org
PHOTON_BASE_URL=https://photon.komoot.io

# Weather: Open-Meteo. Set an API key to use the commercial endpoint.
OPEN_METEO_BASE_URL=https://api.open-meteo.com
OPEN_METEO_API_KEY=

# Truck model
TRUCK_TARE_WEIGHT_LB=33000
TRUCK_MAX_SPEED_MPH=65
TRUCK_APPLY_HOS=true

# Shared cache + cross-instance throttle. REQUIRED on Vercel (serverless instances).
# Upstash Redis (free) from the Vercel Marketplace sets this for you (REDIS_URL or KV_URL).
REDIS_URL=
